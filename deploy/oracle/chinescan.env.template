# Install as /etc/chinescan/chinescan.env with mode 0600.
# Do not commit the populated file.
CHINESCAN_DATABASE_URL=postgresql+psycopg://backend_user:REPLACE_ME@REPLACE_SUPABASE_HOST:5432/postgres?sslmode=require
CHINESCAN_CORS_ALLOWED_ORIGINS=["https://dashboard.example.com"]
CHINESCAN_TRUSTED_PROXY=true
CHINESCAN_SECURE_COOKIE=true
# Keep ordinary evidence on the Oracle filesystem for this deployment.
CHINESCAN_DATABASE_PATH=/var/lib/chinescan/chinescan.sqlite3
CHINESCAN_REPORTS_DIR=/var/lib/chinescan/reports
CHINESCAN_OPERATOR_CREDENTIAL_FILE=/var/lib/chinescan/operator.json
