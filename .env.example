CHINESCAN_ETHERSCAN_KEY=

# Leave empty to use the existing local SQLite backend.
# PostgreSQL requires the reviewed Supabase baseline before startup.
CHINESCAN_DATABASE_URL=
CHINESCAN_CORS_ALLOWED_ORIGINS=[]
CHINESCAN_SECURE_COOKIE=false
# Enable only behind a loopback reverse proxy that strips forwarded headers.
CHINESCAN_TRUSTED_PROXY=false
